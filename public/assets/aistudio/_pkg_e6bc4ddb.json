{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" tsx server.ts",
    "dev:vite": "vite --host 127.0.0.1 --port 5173 --open",
    "dev:mem": "node --max-old-space-size=4096 -r tsx/register server.ts",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs && node scripts/build-extension.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "watch:extension": "node scripts/watch-extension.mjs",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate:scan": "tsx validate.ts scan",
    "validate": "tsx validate.ts validate",
    "validate:dry": "tsx validate.ts validate --dry-run",
    "validate:quarantine": "tsx validate.ts quarantine",
    "validate:approve": "tsx validate.ts approve",
    "validate:audit": "tsx validate.ts audit",
    "validate:report": "tsx validate.ts report",
    "wallpapers:scan": "tsx upload.js --dry-run",
    "wallpapers:collect": "tsx upload.js --copy-only",
    "wallpapers:upload": "tsx upload.js"
  },
  "dependencies": {
    "@animateicons/react": "^0.5.0",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jszip": "^3.4.1",
    "@types/multer": "^2.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "form-data": "^4.0.6",
    "helmet": "^8.3.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "mediabunny": "^1.61.4",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pica": "^10.0.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hot-toast": "^2.6.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "vite": "^6.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "glob": "^13.0.6",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.2"
  }
}
